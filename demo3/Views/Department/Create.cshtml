@model DepartmentRequest
@{
    ViewData["Title"] = "Create";
}
<div class="row justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Create Department</h1>

    <form method="post" asp-controller="Department" asp-action="Create" class="col-8">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-group mb-3">
            @* <label class="form-label" for="code"></label> *@
            @* <input id="code" name="Code" type="text" /> *@
            <label class="form-label" asp-for="code"></label>
            <input asp-for="code" class="form-control" />
            <span asp-validation-for="code" class="text-danger"></span> @*code is required*@
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span> @*Name is required*@
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="Description"></label>
            <textarea class="form-control" asp-for="Description"></textarea>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="CreatedOn"></label>
            <input asp-for="CreatedOn" class="form-control" />
        </div>

        <div class="mt-4 m-auto">
            <input class="btn btn-primary" type="submit" value="Create" />
            <a asp-controller="Department" asp-action="Index" class="btn btn-outline-dark">Back to list</a>
        </div>
    </form>
</div>

@section Validation{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}